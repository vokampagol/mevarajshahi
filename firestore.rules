rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // products/{productId}
    //   id: integer; name/brand: bounded strings; prices: nonnegative numbers;
    //   stock: bounded integer; category: optional enum for older products;
    //   imagePath: optional scoped Firebase Storage path.
    //
    // shops/{shopId}
    //   id: integer; name/address: bounded strings; logoPath/documents:
    //   optional scoped Firebase Storage paths.
    //
    // buyerShops/{buyerShopId}
    //   id: integer; name/category and contact/address fields: bounded strings;
    //   category: Medicine, Mobile, Grocery, Food, Dealer, or Other;
    //   google_maps_link: empty or HTTP(S) URL; createdAt: server timestamp;
    //   createdBy: immutable Firebase Auth UID.
    //
    // orders/{orderId}
    //   id: string matching the document ID; customer details, bounded item
    //   list, totals, payment method, date, selling outlet shopId, createdBy;
    //   optional buyerShopId/buyerShopName/buyerShopCategory for buyer sales.
    //   Order documents contain private customer phone information.
    //
    // All collections are restricted to the verified application administrator.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    function isVerifiedAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'sapaharitsolution@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isValidUrl(url) {
      return url is string
        && (url.matches('^https://.*') || url.matches('^http://.*'));
    }

    function validString(data, field, maxLength) {
      return data[field] is string && data[field].size() <= maxLength;
    }

    function validCategory(category) {
      return category in ['Medicine', 'Mobile', 'Grocery', 'Food', 'Dealer', 'Other'];
    }

    function isRecent(time) {
      return time is timestamp
        && time > request.time - duration.value(5, 'm')
        && time <= request.time;
    }

    function validProduct(data) {
      return hasRequiredFields(data, [
          'id', 'name', 'brand', 'dealer_price', 'retail_price', 'mrp', 'stock'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'name', 'brand', 'dealer_price', 'retail_price', 'mrp', 'stock',
          'category', 'imagePath'
        ])
        && data.id is int
        && validString(data, 'name', 200) && data.name.size() > 0
        && validString(data, 'brand', 80) && data.brand.size() > 0
        && data.dealer_price is number && data.dealer_price >= 0 && data.dealer_price <= 10000000
        && data.retail_price is number && data.retail_price >= 0 && data.retail_price <= 10000000
        && data.mrp is number && data.mrp >= 0 && data.mrp <= 10000000
        && data.stock is int && data.stock >= 0 && data.stock <= 1000000
        && (!('category' in data) || validCategory(data.category))
        && (!('imagePath' in data)
          || (validString(data, 'imagePath', 200)
            && data.imagePath.matches('^uploads/products/[A-Za-z0-9_-]{1,80}/[a-f0-9]{32}\\.(jpg|png|webp)$')));
    }

    function validShop(data) {
      return hasRequiredFields(data, ['id', 'name', 'address'])
        && hasOnlyAllowedFields(data, ['id', 'name', 'address', 'logoPath', 'documents'])
        && data.id is int
        && validString(data, 'name', 120) && data.name.size() > 0
        && validString(data, 'address', 240) && data.address.size() > 0
        && (!('logoPath' in data)
          || (validString(data, 'logoPath', 200)
            && data.logoPath.matches('^uploads/shops/[A-Za-z0-9_-]{1,80}/[a-f0-9]{32}\\.(jpg|png|webp)$')))
        && (!('documents' in data)
          || (data.documents is list
            && data.documents.size() <= 20
            && data.documents.toSet().size() == data.documents.size()));
    }

    function validBuyerShop(data) {
      return hasRequiredFields(data, [
          'id', 'name', 'category', 'area', 'address', 'phone', 'whatsapp',
          'price_range', 'google_maps_link', 'createdAt', 'createdBy'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'name', 'category', 'area', 'address', 'phone', 'whatsapp',
          'price_range', 'google_maps_link', 'createdAt', 'createdBy'
        ])
        && data.id is int
        && validString(data, 'name', 120) && data.name.size() > 0
        && validCategory(data.category)
        && validString(data, 'area', 120)
        && validString(data, 'address', 240)
        && validString(data, 'phone', 40)
        && validString(data, 'whatsapp', 40)
        && validString(data, 'price_range', 80)
        && validString(data, 'google_maps_link', 500)
        && (data.google_maps_link == '' || isValidUrl(data.google_maps_link))
        && data.createdAt is timestamp
        && data.createdBy is string && isOwner(data.createdBy);
    }

    function validBuyerShopSnapshot(data) {
      return (
          !('buyerShopId' in data)
          && !('buyerShopName' in data)
          && !('buyerShopCategory' in data)
        )
        || (
          data.buyerShopId is string
          && data.buyerShopId.size() <= 80
          && data.buyerShopId.matches('^[0-9]{1,20}$')
          && validString(data, 'buyerShopName', 120)
          && data.buyerShopName.size() > 0
          && validCategory(data.buyerShopCategory)
          && exists(/databases/$(database)/documents/buyerShops/$(data.buyerShopId))
          && get(/databases/$(database)/documents/buyerShops/$(data.buyerShopId)).data.name == data.buyerShopName
          && get(/databases/$(database)/documents/buyerShops/$(data.buyerShopId)).data.category == data.buyerShopCategory
        );
    }

    function validOrder(data, orderId) {
      return hasRequiredFields(data, [
          'id', 'customerName', 'customerPhone', 'items', 'subtotal', 'discount',
          'total', 'paymentMethod', 'date', 'shopId', 'createdBy'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'customerName', 'customerPhone', 'items', 'subtotal', 'discount',
          'total', 'paymentMethod', 'date', 'shopId', 'createdBy',
          'buyerShopId', 'buyerShopName', 'buyerShopCategory'
        ])
        && data.id is string && data.id == orderId && data.id.size() <= 64
        && validString(data, 'customerName', 100) && data.customerName.size() > 0
        && validString(data, 'customerPhone', 40) && data.customerPhone.size() > 0
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100
        && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 100000000
        && data.discount is number && data.discount >= 0 && data.discount <= 100000000
        && data.total is number && data.total >= 0 && data.total <= data.subtotal
        && data.paymentMethod in ['Cash', 'bKash', 'Nagad', 'Card']
        && validString(data, 'date', 80) && data.date.size() > 0
        && data.shopId is int
        && data.createdBy is string && data.createdBy == request.auth.uid
        && validBuyerShopSnapshot(data);
    }

    match /products/{productId} {
      allow read: if isVerifiedAdmin();
      allow create: if isVerifiedAdmin()
        && uidUnchanged()
        && validProduct(request.resource.data);
      allow update: if isVerifiedAdmin()
        && uidNotModified()
        && validProduct(request.resource.data)
        && request.resource.data.id == resource.data.id;
      allow delete: if isVerifiedAdmin();
    }

    match /shops/{shopId} {
      allow read: if isVerifiedAdmin();
      allow create: if isVerifiedAdmin()
        && uidUnchanged()
        && validShop(request.resource.data);
      allow update: if isVerifiedAdmin()
        && uidNotModified()
        && validShop(request.resource.data)
        && request.resource.data.id == resource.data.id;
      allow delete: if isVerifiedAdmin();
    }

    match /buyerShops/{buyerShopId} {
      allow read: if isVerifiedAdmin();
      allow create: if isVerifiedAdmin()
        && uidUnchanged()
        && validBuyerShop(request.resource.data)
        && isRecent(request.resource.data.createdAt);
      allow update: if isVerifiedAdmin()
        && uidNotModified()
        && validBuyerShop(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isVerifiedAdmin();
    }

    match /orders/{orderId} {
      allow read: if isVerifiedAdmin();
      allow create: if isVerifiedAdmin()
        && uidUnchanged()
        && validOrder(request.resource.data, orderId);
      allow update: if isVerifiedAdmin()
        && uidNotModified()
        && validOrder(request.resource.data, orderId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isVerifiedAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
