rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isVerifiedAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sapaharitsolution@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validImageUpload(maxBytes) {
      return isVerifiedAdmin()
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /uploads/shops/{shopId}/{fileName} {
      allow read: if isVerifiedAdmin();
      allow create, update: if validImageUpload(5 * 1024 * 1024)
        && fileName.matches('^[a-f0-9]{32}\\.(jpg|png|webp)$');
      allow delete: if isVerifiedAdmin();
    }

    match /uploads/products/{productId}/{fileName} {
      allow read: if isVerifiedAdmin();
      allow create, update: if validImageUpload(5 * 1024 * 1024)
        && fileName.matches('^[a-f0-9]{32}\\.(jpg|png|webp)$');
      allow delete: if isVerifiedAdmin();
    }

    match /uploads/documents/{shopId}/{fileName} {
      allow read: if isVerifiedAdmin();
      allow create, update: if isVerifiedAdmin()
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && fileName.matches('^[a-f0-9]{32}\\.pdf$');
      allow delete: if isVerifiedAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
